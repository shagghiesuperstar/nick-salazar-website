    <!-- 11. Why independent -->
    <section class="section why" id="why">
      <div class="section__inner">
        <h2 class="section__title">Why an independent surveyor</h2>
        <div class="why__points">
          <article class="why__point" data-reveal>
            <h3 class="why__heading">No side to take</h3>
            <p class="why__text">Nick is engaged by one party and answerable to the facts. That independence is what makes a survey report worth relying on by everyone who has to read it.</p>
          </article>
          <article class="why__point" data-reveal>
            <h3 class="why__heading">Evidence built to be read later</h3>
            <p class="why__text">Photographs, tallies, measurements and a clear timeline, written for someone who was not there and needs to understand what happened months afterwards.</p>
          </article>
          <article class="why__point" data-reveal>
            <h3 class="why__heading">One name on the report</h3>
            <p class="why__text">The person who attends is the person who writes and signs. Questions about the survey go to the surveyor who was on site.</p>
          </article>
        </div>
      </div>
    </section>

